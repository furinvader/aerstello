{
  "name": "@sky-bar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node dist/migrate-cli.js",
    "admin:create": "node dist/admin-create.js",
    "db:migrate:dev": "tsx src/migrate-cli.ts",
    "admin:create:dev": "tsx src/admin-create.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.2",
    "@sky-bar/shared": "0.1.0",
    "argon2": "^0.43.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
