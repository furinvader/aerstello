DATABASE_URL=postgres://skybar:skybar@localhost:5432/skybar
PORT=3001
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# Ordered active-first as key-id:secret. During the first rolling upgrade, use
# the current SESSION_SECRET value for v1; keep this key pinned when rotating sessions.
ACCESS_CAPABILITY_KEYS=v1:replace-with-at-least-32-random-characters
# Set only while upgrading a database with bills from before migration 0007.
# LEGACY_BILL_TIMEZONE=Europe/Berlin
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_MAX=300
ACCESS_STATUS_IP_LIMIT_MAX=3000
