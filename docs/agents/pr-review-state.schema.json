{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sky-bar.local/schemas/pr-review-state.schema.json",
  "title": "Sky Bar active PR review state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "revision", "repository", "prNumber", "phase", "baseSha",
    "requestedHeadSha", "reviewedHeadSha", "currentIntegrationHeadSha", "reviewRound",
    "verificationReviewUsed", "legacyReviewProvenance", "releaseBaseline", "decisions", "tasks", "reviewRequest",
    "reviewOutcome", "reviewHistory", "verificationEscalation", "humanFinalReviewAuthorization",
    "threadResolutionStatus", "blockedReasons",
    "validationStatus", "ciValidationStatus", "ciValidationHistory", "nextAction", "integrationWorktree", "orchestratorSessionId",
    "abandonmentReason", "git", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "revision": { "type": "integer", "minimum": 0 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 256 },
    "prNumber": { "type": "integer", "minimum": 1 },
    "phase": {
      "enum": [
        "recovering", "ready-for-review", "awaiting-review", "triaging", "implementing",
        "integrating", "verifying", "validating", "awaiting-human-decision", "blocked", "complete"
      ]
    },
    "baseSha": { "$ref": "#/$defs/sha" },
    "requestedHeadSha": { "$ref": "#/$defs/nullableSha" },
    "reviewedHeadSha": { "$ref": "#/$defs/nullableSha" },
    "currentIntegrationHeadSha": { "$ref": "#/$defs/sha" },
    "reviewRound": { "type": "integer", "minimum": 0, "maximum": 3 },
    "verificationReviewUsed": { "type": "boolean" },
    "legacyReviewProvenance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "discoveryRounds", "migratedAt"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "discoveryRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
            "migratedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "releaseBaseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["version", "tag", "commit", "releasedAt"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
            "commit": { "$ref": "#/$defs/sha" },
            "releasedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "decisions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "tasks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/task" } },
    "reviewRequest": { "$ref": "#/$defs/nullableReviewRequest" },
    "reviewOutcome": { "$ref": "#/$defs/nullableReviewOutcome" },
    "reviewHistory": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["request", "outcome"],
        "properties": {
          "request": { "$ref": "#/$defs/reviewRequest" },
          "outcome": { "$ref": "#/$defs/nullableReviewOutcome" }
        }
      }
    },
    "verificationEscalation": { "$ref": "#/$defs/nullableVerificationEscalation" },
    "humanFinalReviewAuthorization": { "$ref": "#/$defs/nullableHumanFinalReviewAuthorization" },
    "threadResolutionStatus": { "$ref": "#/$defs/threadResolutionStatus" },
    "blockedReasons": { "$ref": "#/$defs/stringList" },
    "validationStatus": { "$ref": "#/$defs/targetedProofStatus" },
    "ciValidationStatus": { "$ref": "#/$defs/ciProofStatus" },
    "ciValidationHistory": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/ciProofStatus" },
          { "type": "object", "properties": { "status": { "enum": ["passed", "failed"] } } }
        ]
      }
    },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "integrationWorktree": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "orchestratorSessionId": { "$ref": "#/$defs/nullableString" },
    "abandonmentReason": { "$ref": "#/$defs/nullableString" },
    "git": {
      "type": "object", "additionalProperties": false, "required": ["branch", "headSha", "dirty"],
      "properties": {
        "branch": { "$ref": "#/$defs/nullableString" },
        "headSha": { "$ref": "#/$defs/sha" },
        "dirty": { "type": "boolean" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "verificationReviewUsed": { "const": true } }, "required": ["verificationReviewUsed"] },
      "then": { "properties": { "reviewRound": { "const": 3 } } }
    },
    {
      "if": { "properties": { "phase": { "const": "awaiting-review" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "reviewRequest": { "$ref": "#/$defs/reviewRequest" },
          "reviewOutcome": { "type": "null" },
          "reviewHistory": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "ready-for-review" } }, "required": ["phase"] },
      "then": {
        "$comment": "The manual validator remains authoritative for equality of validation, thread-proof, and Git HEADs with currentIntegrationHeadSha because Draft 2020-12 cannot compare sibling values.",
        "properties": {
          "reviewRound": { "type": "integer", "maximum": 3 },
          "verificationEscalation": { "type": "null" },
          "validationStatus": {
            "allOf": [{ "$ref": "#/$defs/targetedProofStatus" }, { "type": "object", "properties": { "status": { "const": "passed" } } }]
          },
          "threadResolutionStatus": {
            "allOf": [{ "$ref": "#/$defs/threadResolutionStatus" }, { "type": "object", "properties": { "status": { "const": "passed" } } }]
          },
          "blockedReasons": { "type": "array", "maxItems": 0 },
          "git": {
            "type": "object",
            "properties": { "dirty": { "const": false } }
          },
          "tasks": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/task" },
                { "type": "object", "properties": { "status": { "const": "completed" }, "disposition": { "not": { "const": "needs-human-decision" } } } }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "reviewRound": { "const": 3 } }, "required": ["reviewRound"] },
            "then": { "properties": { "verificationReviewUsed": { "const": false } } }
          },
          {
            "if": {
              "properties": {
                "tasks": {
                  "type": "array",
                  "contains": {
                    "type": "object", "required": ["sourceType", "status"],
                    "properties": { "sourceType": { "const": "local" }, "status": { "const": "completed" } }
                  }
                }
              },
              "required": ["tasks"]
            },
            "then": {
              "properties": {
                "threadResolutionStatus": {
                  "type": "object", "required": ["localVerification"],
                  "properties": {
                    "localVerification": {
                      "allOf": [
                        { "$ref": "#/$defs/localVerification" },
                        { "type": "object", "properties": { "status": { "const": "passed" } } }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "complete" } }, "required": ["phase"] },
      "then": {
        "$comment": "The manual validator remains authoritative for equality among requested, reviewed, request, outcome, targeted-validation, thread-proof, CI, Git, and integration HEADs, and for request/outcome identity binding, because Draft 2020-12 cannot compare sibling values.",
        "properties": {
          "reviewRound": { "type": "integer", "minimum": 1 },
          "requestedHeadSha": { "$ref": "#/$defs/sha" },
          "reviewedHeadSha": { "$ref": "#/$defs/sha" },
          "reviewRequest": { "$ref": "#/$defs/reviewRequest" },
          "reviewOutcome": {
            "allOf": [{ "$ref": "#/$defs/reviewOutcome" }, { "type": "object", "properties": { "outcome": { "const": "clean" } } }]
          },
          "verificationEscalation": { "type": "null" },
          "validationStatus": {
            "allOf": [{ "$ref": "#/$defs/targetedProofStatus" }, { "type": "object", "properties": { "status": { "const": "passed" } } }]
          },
          "ciValidationStatus": {
            "allOf": [{ "$ref": "#/$defs/ciProofStatus" }, { "type": "object", "properties": { "status": { "const": "passed" } } }]
          },
          "ciValidationHistory": { "type": "array", "minItems": 1 },
          "reviewHistory": { "type": "array", "minItems": 1 },
          "threadResolutionStatus": {
            "allOf": [{ "$ref": "#/$defs/threadResolutionStatus" }, { "type": "object", "properties": { "status": { "const": "passed" } } }]
          },
          "blockedReasons": { "type": "array", "maxItems": 0 },
          "git": {
            "type": "object",
            "properties": { "dirty": { "const": false } }
          },
          "tasks": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/task" },
                { "type": "object", "properties": { "status": { "const": "completed" }, "disposition": { "not": { "const": "needs-human-decision" } } } }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "reviewRequest": { "type": "object", "properties": { "kind": { "const": "verification" } } } }, "required": ["reviewRequest"] },
            "then": { "properties": { "reviewRound": { "const": 3 }, "verificationReviewUsed": { "const": true } } }
          },
          {
            "if": { "properties": { "reviewRequest": { "type": "object", "properties": { "kind": { "const": "human-final" } } } }, "required": ["reviewRequest"] },
            "then": {
              "properties": {
                "reviewRound": { "const": 3 },
                "verificationReviewUsed": { "const": true },
                "humanFinalReviewAuthorization": { "$ref": "#/$defs/humanFinalReviewAuthorization" },
                "reviewHistory": { "type": "array", "minItems": 5, "maxItems": 5 }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tasks": {
                  "type": "array",
                  "contains": {
                    "type": "object", "required": ["sourceType", "status"],
                    "properties": { "sourceType": { "const": "local" }, "status": { "const": "completed" } }
                  }
                }
              },
              "required": ["tasks"]
            },
            "then": {
              "properties": {
                "threadResolutionStatus": {
                  "type": "object", "required": ["localVerification"],
                  "properties": {
                    "localVerification": {
                      "allOf": [
                        { "$ref": "#/$defs/localVerification" },
                        { "type": "object", "properties": { "status": { "const": "passed" } } }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "humanFinalReviewAuthorization": { "type": "object" } },
        "required": ["humanFinalReviewAuthorization"]
      },
      "then": {
        "$comment": "The manual validator binds authorization to the exact fourth verification-findings outcome and its durable decision.",
        "properties": {
          "reviewRound": { "const": 3 },
          "verificationReviewUsed": { "const": true },
          "decisions": { "type": "array", "minItems": 1 },
          "reviewHistory": { "type": "array", "minItems": 4, "maxItems": 5 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewOutcome": {
            "type": "object", "required": ["kind", "outcome"],
            "properties": { "kind": { "enum": ["verification", "human-final"] }, "outcome": { "const": "findings" } }
          }
        },
        "required": ["reviewOutcome"]
      },
      "then": { "properties": { "phase": { "const": "awaiting-human-decision" } } }
    },
    {
      "if": { "properties": { "verificationEscalation": { "type": "object" } }, "required": ["verificationEscalation"] },
      "then": {
        "properties": {
          "phase": { "const": "awaiting-human-decision" },
          "verificationReviewUsed": { "const": true },
          "reviewRequest": {
            "allOf": [{ "$ref": "#/$defs/reviewRequest" }, { "type": "object", "properties": { "kind": { "enum": ["verification", "human-final"] } } }]
          },
          "reviewOutcome": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "nullableSha": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "nullableString": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 1000 }]
    },
    "stringList": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "reviewRequest": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "databaseId", "url", "headSha", "at", "kind", "body", "authorLogin", "authorNodeId"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "databaseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
        "headSha": { "$ref": "#/$defs/sha" },
        "at": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["discovery", "verification", "human-final"] },
        "body": { "const": "@codex review" },
        "authorLogin": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorNodeId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "nullableReviewRequest": { "oneOf": [{ "$ref": "#/$defs/reviewRequest" }, { "type": "null" }] },
    "reviewOutcome": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "databaseId", "url", "headSha", "at", "requestId", "kind", "outcome",
        "evidenceType", "reviewerLogin", "reviewerNodeId", "reviewerType", "reviewerUrl",
        "reactionContent", "reactionCommentId"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "databaseId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
        "headSha": { "$ref": "#/$defs/sha" },
        "at": { "type": "string", "format": "date-time" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "enum": ["discovery", "verification", "human-final"] },
        "outcome": { "enum": ["clean", "findings"] },
        "evidenceType": { "enum": ["review-submission", "request-reaction", "issue-comment"] },
        "reviewerLogin": { "const": "chatgpt-codex-connector" },
        "reviewerNodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reviewerType": { "const": "Bot" },
        "reviewerUrl": { "const": "https://github.com/apps/chatgpt-codex-connector" },
        "reactionContent": { "oneOf": [{ "const": "THUMBS_UP" }, { "type": "null" }] },
        "reactionCommentId": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceType": { "const": "request-reaction" } }, "required": ["evidenceType"] },
          "then": {
            "properties": {
              "outcome": { "const": "clean" },
              "reactionContent": { "const": "THUMBS_UP" },
              "reactionCommentId": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "else": {
            "properties": { "reactionContent": { "type": "null" }, "reactionCommentId": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "evidenceType": { "const": "issue-comment" } }, "required": ["evidenceType"] },
          "then": { "properties": { "outcome": { "const": "clean" } } }
        }
      ]
    },
    "nullableReviewOutcome": { "oneOf": [{ "$ref": "#/$defs/reviewOutcome" }, { "type": "null" }] },
    "verificationEscalation": {
      "type": "object", "additionalProperties": false,
      "$comment": "The manual validator binds requestId and requestHeadSha to the current pending verification request because Draft 2020-12 cannot compare sibling property values.",
      "required": ["requestId", "requestHeadSha", "observedPrHeadSha", "headRelation", "evidenceIds", "reason", "at"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requestHeadSha": { "$ref": "#/$defs/sha" },
        "observedPrHeadSha": { "$ref": "#/$defs/sha" },
        "headRelation": { "enum": ["same", "changed"] },
        "evidenceIds": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "reason": {
          "enum": ["stale-canonical-evidence", "ambiguous-canonical-evidence", "request-head-drift"]
        },
        "at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "reason": { "const": "request-head-drift" } }, "required": ["reason"] },
          "then": { "properties": { "headRelation": { "const": "changed" } } },
          "else": { "properties": { "headRelation": { "const": "same" } } }
        }
      ]
    },
    "nullableVerificationEscalation": {
      "oneOf": [{ "$ref": "#/$defs/verificationEscalation" }, { "type": "null" }]
    },
    "humanFinalReviewAuthorization": {
      "type": "object", "additionalProperties": false,
      "$comment": "The manual validator binds decisionId to an immutable durable decision and verificationOutcomeId to the exact terminal verification-findings history entry.",
      "required": ["decisionId", "source", "authorizedAt", "verificationOutcomeId", "notBefore", "summary"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "const": "operator-instruction" },
        "authorizedAt": { "type": "string", "format": "date-time" },
        "verificationOutcomeId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "notBefore": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    },
    "nullableHumanFinalReviewAuthorization": {
      "oneOf": [{ "$ref": "#/$defs/humanFinalReviewAuthorization" }, { "type": "null" }]
    },
    "targetedProofStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "scope", "status", "headSha", "checks", "updatedAt"],
      "properties": {
        "source": { "const": "orchestrator" },
        "scope": { "const": "targeted" },
        "status": { "enum": ["not-run", "passed", "failed"] },
        "headSha": { "$ref": "#/$defs/nullableSha" },
        "checks": { "$ref": "#/$defs/stringList" },
        "updatedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "type": "null" }, "checks": { "type": "array", "maxItems": 0 }, "updatedAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "$ref": "#/$defs/sha" }, "checks": { "type": "array", "minItems": 1 },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "ciProofStatus": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source", "scope", "status", "headSha", "checks", "workflowRunId", "workflowRunUrl", "updatedAt"
      ],
      "properties": {
        "source": { "const": "github-actions" },
        "scope": { "const": "full" },
        "status": { "enum": ["not-run", "passed", "failed"] },
        "headSha": { "$ref": "#/$defs/nullableSha" },
        "checks": { "$ref": "#/$defs/stringList" },
        "checkRunId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }]
        },
        "workflowRunId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "workflowRunUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "updatedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "type": "null" }, "checks": { "type": "array", "maxItems": 0 },
              "checkRunId": { "type": "null" }, "workflowRunId": { "type": "null" }, "workflowRunUrl": { "type": "null" },
              "updatedAt": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "headSha": { "$ref": "#/$defs/sha" }, "checks": { "type": "array", "minItems": 1 },
              "checkRunId": { "type": "string", "minLength": 1, "maxLength": 500 },
              "workflowRunId": { "type": "integer", "minimum": 1 },
              "workflowRunUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "threadRecord": {
      "type": "object", "additionalProperties": false,
      "required": [
        "threadNodeId", "rootCommentNodeId", "rootCommentDatabaseId", "taskIds", "disposition", "replyId", "replyUrl",
        "isResolved", "resolvedAt", "resolvedBy", "observedHeadSha"
      ],
      "properties": {
        "threadNodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rootCommentNodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rootCommentDatabaseId": { "type": "integer", "minimum": 1 },
        "taskIds": { "$ref": "#/$defs/stringList" },
        "disposition": {
          "enum": ["fixed", "duplicate", "already-fixed", "stale", "invalid", "policy-conflict", "out-of-scope"]
        },
        "replyId": { "$ref": "#/$defs/nullableString" },
        "replyUrl": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 }] },
        "isResolved": { "type": "boolean" },
        "resolvedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "resolvedBy": { "$ref": "#/$defs/nullableString" },
        "observedHeadSha": { "$ref": "#/$defs/sha" }
      },
      "allOf": [
        {
          "if": { "properties": { "isResolved": { "const": true } }, "required": ["isResolved"] },
          "then": {
            "properties": {
              "resolvedAt": { "type": "string", "format": "date-time" },
              "resolvedBy": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "replyId": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "replyUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 }
            }
          },
          "else": { "properties": { "resolvedAt": { "type": "null" }, "resolvedBy": { "type": "null" } } }
        },
        {
          "if": { "properties": { "replyId": { "type": "null" } }, "required": ["replyId"] },
          "then": { "properties": { "replyUrl": { "type": "null" } } },
          "else": {
            "properties": {
              "replyId": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "replyUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 }
            }
          }
        }
      ]
    },
    "threadlessVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "headSha", "taskIds", "updatedAt"],
      "properties": {
        "status": { "enum": ["not-run", "passed", "failed"] },
        "headSha": { "$ref": "#/$defs/nullableSha" },
        "taskIds": { "$ref": "#/$defs/stringList" },
        "updatedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": { "properties": { "headSha": { "type": "null" }, "taskIds": { "type": "array", "maxItems": 0 }, "updatedAt": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": { "properties": { "headSha": { "$ref": "#/$defs/sha" }, "updatedAt": { "type": "string", "format": "date-time" } } }
        }
      ]
    },
    "localVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "headSha", "taskIds", "updatedAt"],
      "properties": {
        "status": { "enum": ["not-run", "passed", "failed"] },
        "headSha": { "$ref": "#/$defs/nullableSha" },
        "taskIds": { "$ref": "#/$defs/stringList" },
        "updatedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": { "properties": { "headSha": { "type": "null" }, "taskIds": { "type": "array", "maxItems": 0 }, "updatedAt": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "$ref": "#/$defs/sha" }, "taskIds": { "type": "array", "minItems": 1 },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "threadResolutionStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "headSha", "threads", "threadlessVerification", "updatedAt"],
      "properties": {
        "status": { "enum": ["not-run", "passed", "failed"] },
        "headSha": { "$ref": "#/$defs/nullableSha" },
        "threads": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/threadRecord" },
          "$comment": "The manual validator additionally enforces unique threadNodeId, rootCommentNodeId, rootCommentDatabaseId, and non-null replyId keys; Draft 2020-12 uniqueItems only rejects identical records."
        },
        "threadlessVerification": { "$ref": "#/$defs/threadlessVerification" },
        "localVerification": { "$ref": "#/$defs/localVerification" },
        "updatedAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "type": "null" },
              "updatedAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "headSha": { "$ref": "#/$defs/sha" },
              "threads": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/threadRecord" }, { "type": "object", "properties": { "isResolved": { "const": true } } }] } },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dependencies", "ownedPaths", "worker", "branch", "worktree", "workerCommitSha",
        "validationSummaries", "lastError"
      ],
      "properties": {
        "dependencies": { "$ref": "#/$defs/stringList" },
        "ownedPaths": { "$ref": "#/$defs/stringList" },
        "worker": { "$ref": "#/$defs/nullableString" },
        "branch": { "$ref": "#/$defs/nullableString" },
        "worktree": { "$ref": "#/$defs/nullableString" },
        "workerCommitSha": { "$ref": "#/$defs/nullableSha" },
        "validationSummaries": { "$ref": "#/$defs/stringList" },
        "lastError": { "$ref": "#/$defs/nullableString" }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sourceIds", "sourceType", "fingerprint", "summary", "severity", "disposition",
        "status", "integratedCommitSha", "resolutionSummary"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceIds": { "$ref": "#/$defs/stringList" },
        "sourceType": { "enum": ["github-thread", "github-threadless", "local"] },
        "fingerprint": { "type": "string", "minLength": 8, "maxLength": 256 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "disposition": {
          "enum": [
            "actionable", "duplicate", "already-fixed", "stale", "invalid", "policy-conflict",
            "out-of-scope", "needs-human-decision"
          ]
        },
        "status": {
          "enum": [
            "proposed", "queued", "running", "implemented", "integrated", "completed",
            "blocked", "not-applicable", "failed"
          ]
        },
        "integratedCommitSha": { "$ref": "#/$defs/nullableSha" },
        "resolutionSummary": { "$ref": "#/$defs/nullableString" },
        "taskPacketDigest": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "execution": { "$ref": "#/$defs/execution" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["proposed", "queued", "running", "implemented", "blocked", "failed"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["execution"],
            "properties": { "execution": { "$ref": "#/$defs/execution" }, "integratedCommitSha": { "type": "null" } }
          },
          "else": { "properties": { "execution": false } }
        },
        {
          "if": { "properties": { "status": { "enum": ["integrated", "completed", "not-applicable"] } }, "required": ["status"] },
          "then": { "properties": { "resolutionSummary": { "type": "string", "minLength": 1, "maxLength": 1000 } } }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["integrated", "completed"] }, "disposition": { "const": "actionable" } },
            "required": ["status", "disposition"]
          },
          "then": { "properties": { "integratedCommitSha": { "$ref": "#/$defs/sha" } } }
        }
      ]
    }
  }
}
