{
  "description": "Durable Aerstello change-development and PR-review recovery, compaction, and worker-result validation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/pr-review-cycle/scripts/hooks/session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Recovering PR review state",
            "additionalContextLimit": 2500
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/change-development/scripts/hooks/session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Recovering change-development state",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/pr-review-cycle/scripts/hooks/pre-compact.mjs\"",
            "timeout": 10,
            "statusMessage": "Checkpointing PR review state"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/change-development/scripts/hooks/pre-compact.mjs\"",
            "timeout": 10,
            "statusMessage": "Checkpointing change-development state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^review_fix_worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/pr-review-cycle/scripts/hooks/subagent-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "Validating review worker result"
          }
        ]
      },
      {
        "matcher": "^implementation_worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/change-development/scripts/hooks/subagent-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "Validating implementation worker result"
          }
        ]
      }
    ]
  }
}
