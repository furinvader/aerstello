{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerstello.local/schemas/specialist-registry-v2.schema.json",
  "title": "Aerstello specialist registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "affectedAreas", "riskTags", "profiles", "reviewers", "routing"],
  "properties": {
    "$schema": { "type": "string", "const": "./schemas/registry.schema.json" },
    "schemaVersion": { "const": 2 },
    "affectedAreas": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": { "enum": ["api", "web", "shared", "workflow", "documentation", "release", "migration"] }
    },
    "riskTags": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": { "enum": ["authentication", "authorization", "billing", "money", "migration", "release", "offline", "realtime", "localization", "responsive", "deployment", "workflow"] }
    },
    "profiles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "guidePath", "compatibleAffectedAreas", "supportedRiskTags"],
        "properties": {
          "id": { "enum": ["web", "api", "contracts", "data-integrity", "behavior-tests", "ops-workflow"] },
          "guidePath": { "type": "string", "pattern": "^profiles/[a-z-]+\\.md$" },
          "compatibleAffectedAreas": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["api", "web", "shared", "workflow", "documentation", "release", "migration"] }
          },
          "supportedRiskTags": {
            "type": "array", "uniqueItems": true,
            "items": { "enum": ["authentication", "authorization", "billing", "money", "migration", "release", "offline", "realtime", "localization", "responsive", "deployment", "workflow"] }
          }
        }
      }
    },
    "reviewers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "phase", "readOnly", "nonDelegating", "githubWrites", "subjectBinding", "guidance"],
        "properties": {
          "id": { "enum": ["behavior_mapper", "security_reviewer", "offline_realtime_reviewer"] },
          "phase": { "enum": ["planning", "review"] },
          "readOnly": { "const": true },
          "nonDelegating": { "const": true },
          "githubWrites": { "const": false },
          "subjectBinding": { "enum": ["planning", "integrated"] },
          "guidance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["behaviorMapper", "securityReviewerRiskTags", "offlineRealtimeReviewerRiskTags", "dataIntegrityGuidanceRiskTags", "opsWorkflowGuidanceRiskTags", "finalVerificationHighPriorityRiskTags"],
      "properties": {
        "behaviorMapper": {
          "type": "object", "additionalProperties": false,
          "required": ["specializations", "riskTags", "signals"],
          "properties": {
            "specializations": { "type": "array", "items": { "const": "behavior-tests" } },
            "riskTags": { "type": "array", "items": { "enum": ["localization", "responsive"] } },
            "signals": { "type": "array", "items": { "enum": ["browserVisible", "testSelectionUncertain"] } }
          }
        },
        "securityReviewerRiskTags": { "type": "array", "items": { "enum": ["authentication", "authorization"] } },
        "offlineRealtimeReviewerRiskTags": { "type": "array", "items": { "enum": ["offline", "realtime"] } },
        "dataIntegrityGuidanceRiskTags": { "type": "array", "items": { "enum": ["billing", "money", "migration", "release"] } },
        "opsWorkflowGuidanceRiskTags": { "type": "array", "items": { "enum": ["deployment", "workflow"] } },
        "finalVerificationHighPriorityRiskTags": { "type": "array", "items": { "enum": ["billing", "money", "migration", "release"] } }
      }
    }
  }
}
