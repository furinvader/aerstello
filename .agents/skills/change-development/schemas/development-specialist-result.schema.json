{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://aerstello.local/schemas/change-development/development-specialist-result-v1.schema.json",
  "title":"Exact-HEAD routed development specialist result v1", "type":"object", "additionalProperties":false,
  "required":["schemaVersion","reviewerId","headSha","specialistPlanDigest","status","summary","findings","recordedAt"],
  "properties":{"schemaVersion":{"const":1},"reviewerId":{"enum":["security_reviewer","offline_realtime_reviewer"]},"headSha":{"$ref":"#/$defs/sha"},
    "specialistPlanDigest":{"$ref":"#/$defs/digest"},"status":{"enum":["clean","findings"]},"summary":{"$ref":"#/$defs/text"},
    "findings":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/finding"}},"recordedAt":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"const":"clean"}}},"then":{"properties":{"findings":{"type":"array","maxItems":0}}}},{"if":{"properties":{"status":{"const":"findings"}}},"then":{"properties":{"findings":{"type":"array","minItems":1}}}}],
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{40}([0-9a-f]{24})?$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"text":{"type":"string","minLength":1,"maxLength":4000,"pattern":"\\S"},"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":128},
    "finding":{"type":"object","additionalProperties":false,"required":["id","priority","summary","evidence","affectedAreas","recommendedSpecialization","riskTags","criterionIds","invariantIds"],"properties":{"id":{"$ref":"#/$defs/id"},"priority":{"enum":["P0","P1","P2","P3"]},"summary":{"$ref":"#/$defs/text"},"evidence":{"$ref":"#/$defs/text"},"affectedAreas":{"type":"array","minItems":1,"maxItems":7,"uniqueItems":true,"items":{"enum":["api","web","shared","workflow","documentation","release","migration"]}},"recommendedSpecialization":{"enum":["web","api","contracts","data-integrity","behavior-tests","ops-workflow"]},"riskTags":{"type":"array","maxItems":12,"uniqueItems":true,"items":{"enum":["authentication","authorization","billing","money","migration","release","offline","realtime","localization","responsive","deployment","workflow"]}},"criterionIds":{"type":"array","maxItems":500,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"invariantIds":{"type":"array","maxItems":500,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}}
  }
}
