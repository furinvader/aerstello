{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerstello.local/schemas/change-development/scope-decision-v1.schema.json",
  "title": "Change-development scope decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "decisionId", "revision", "disposition", "evidence", "rationale", "approvedShape", "deferredFollowups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": { "$ref": "#/$defs/id" },
    "decisionId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "disposition": { "enum": ["approve-material-amendment", "split-defer", "reject-use-narrow", "abandon-replan"] },
    "evidence": { "$ref": "#/$defs/evidence" },
    "rationale": { "$ref": "#/$defs/text" },
    "approvedShape": { "$ref": "#/$defs/identities" },
    "deferredFollowups": { "$ref": "#/$defs/identities" }
  },
  "allOf": [
    { "if": { "properties": { "disposition": { "const": "split-defer" } }, "required": ["disposition"] }, "then": { "properties": { "deferredFollowups": { "type": "array", "items": { "$ref": "#/$defs/id" } } } } },
    { "if": { "properties": { "disposition": { "const": "approve-material-amendment" } }, "required": ["disposition"] }, "then": { "properties": { "approvedShape": { "type": "array", "minItems": 1 } } }, "else": { "properties": { "approvedShape": { "type": "array", "maxItems": 0 } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "identity": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "identities": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDigest", "planningSha", "planDigest", "amendmentDigests", "closureDigest", "subjectDigest", "subjectSha", "assessmentPacketDigest", "assessmentResultDigest"],
      "properties": {
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "planningSha": { "$ref": "#/$defs/sha" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "amendmentDigests": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/digest" } },
        "closureDigest": { "$ref": "#/$defs/digest" },
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "subjectSha": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "assessmentPacketDigest": { "$ref": "#/$defs/digest" },
        "assessmentResultDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
