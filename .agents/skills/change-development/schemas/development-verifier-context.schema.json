{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://aerstello.local/schemas/change-development/development-verifier-context-v1.schema.json",
  "title":"Bounded development integration verifier context v1", "type":"object", "additionalProperties":false,
  "required":["schemaVersion","verifierId","finalVerificationPriority","verificationRound","inputIdentityDigest","changeId","headSha","planningSha","originalPlanDigest","effectivePlanDigest","taskSetDigest","sourceIdentity","validationPlanDigest","validationResultDigests","specialistResultDigests","evidence","generatedAt"],
  "properties":{"schemaVersion":{"const":1},"verifierId":{"const":"development_integration_verifier"},"finalVerificationPriority":{"enum":["standard","high"]},"verificationRound":{"type":"integer","minimum":1},"inputIdentityDigest":{"$ref":"#/$defs/digest"},"changeId":{"$ref":"#/$defs/id"},"headSha":{"$ref":"#/$defs/sha"},"planningSha":{"$ref":"#/$defs/sha"},
    "originalPlanDigest":{"$ref":"#/$defs/digest"},"effectivePlanDigest":{"$ref":"#/$defs/digest"},"taskSetDigest":{"$ref":"#/$defs/digest"},
    "sourceIdentity":{"type":"object","additionalProperties":false,"required":["kind","reference","digest"],"properties":{"kind":{"enum":["github-issue","direct-request","repository-plan","partial-implementation"]},"reference":{"$ref":"#/$defs/text"},"digest":{"$ref":"#/$defs/digest"}}},
    "validationPlanDigest":{"$ref":"#/$defs/digest"},"validationResultDigests":{"$ref":"#/$defs/digests"},"specialistResultDigests":{"$ref":"#/$defs/digests"},
    "evidence":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["kind","id","digest","summary"],"properties":{"kind":{"enum":["criterion","decision","amendment","checklist","packet","provenance","result","integration","validation-plan","validation-result","release","source","planning-helper","specialist-route","supplemental-guidance","specialist-result","finding-disposition"]},"id":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"},"summary":{"$ref":"#/$defs/text"}}}},
    "generatedAt":{"type":"string","format":"date-time"}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":128},"sha":{"type":"string","pattern":"^[0-9a-f]{40}([0-9a-f]{24})?$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"digests":{"type":"array","maxItems":500,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"text":{"type":"string","minLength":1,"maxLength":2000,"pattern":"\\S"}}
}
