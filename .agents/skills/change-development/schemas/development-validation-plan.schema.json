{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerstello.local/schemas/change-development/development-validation-plan-v1.schema.json",
  "title": "Exact-HEAD development validation plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "effectivePlanDigest", "headSha", "createdAt", "taskSetDigest", "tasks", "commands", "releaseEvidence"],
  "properties": {
    "schemaVersion": { "const": 1 }, "changeId": { "$ref": "#/$defs/id" }, "effectivePlanDigest": { "$ref": "#/$defs/digest" }, "headSha": { "$ref": "#/$defs/sha" },
    "createdAt": { "type": "string", "format": "date-time" }, "taskSetDigest": { "$ref": "#/$defs/digest" },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/task" } },
    "commands": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/command" } },
    "releaseEvidence": { "oneOf": [{ "$ref": "#/$defs/releaseEvidence" }, { "type": "null" }] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "task": { "type": "object", "additionalProperties": false, "required": ["taskId", "binding", "packetDigest", "resultDigest", "provenanceDigest", "terminalStatus", "integratedCommit", "integrationReceiptDigest"], "properties": {
      "taskId": { "$ref": "#/$defs/id" }, "binding": { "type": "integer", "minimum": 1 }, "packetDigest": { "$ref": "#/$defs/digest" }, "resultDigest": { "$ref": "#/$defs/digest" },
      "provenanceDigest": { "$ref": "#/$defs/digest" }, "terminalStatus": { "enum": ["integrated", "no-change"] },
      "integratedCommit": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "integrationReceiptDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
    }, "allOf": [{ "if": { "properties": { "terminalStatus": { "const": "integrated" } } }, "then": { "properties": { "integratedCommit": { "$ref": "#/$defs/sha" }, "integrationReceiptDigest": { "$ref": "#/$defs/digest" } } }, "else": { "properties": { "integratedCommit": { "type": "null" }, "integrationReceiptDigest": { "type": "null" } } } }]},
    "command": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "argv", "reasons", "taskIds", "selectors", "projects"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["unit", "system"] },
      "argv": { "type": "array", "minItems": 2, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
      "reasons": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
      "taskIds": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
      "selectors": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^@[a-z0-9]+(?:-[a-z0-9]+)*$" } },
      "projects": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["tablet-chromium", "mobile-webkit", "desktop-firefox"] } }
    }},
    "releaseEvidence": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "baseSha", "headSha", "releaseRef", "releaseRefSha", "status", "latestRelease", "frozenMigrationCount", "evidenceDigest"], "properties": {
      "schemaVersion": { "const": 1 }, "baseSha": { "$ref": "#/$defs/sha" }, "headSha": { "$ref": "#/$defs/sha" },
      "releaseRef": { "$ref": "#/$defs/text" }, "releaseRefSha": { "$ref": "#/$defs/sha" },
      "status": { "enum": ["pre-release", "released", "stale"] }, "latestRelease": { "oneOf": [{ "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }, { "type": "null" }] },
      "frozenMigrationCount": { "type": "integer", "minimum": 0 }, "evidenceDigest": { "$ref": "#/$defs/digest" }
    }}
  }
}
