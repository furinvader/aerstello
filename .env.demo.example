# Copy this file to .env.demo, or run: scripts/demo-deploy.sh --init-env
# Keep .env.demo private (mode 0600) and do not commit it.
COMPOSE_PROJECT_NAME=sky-bar-demo
SKY_BAR_DOMAIN=
ACME_EMAIL=
ADMIN_EMAIL=
ADMIN_NAME=
POSTGRES_PASSWORD=
SESSION_SECRET=
# Ordered active-first as key-id:secret. Keep every secret distinct from SESSION_SECRET.
ACCESS_CAPABILITY_KEYS=
LOG_LEVEL=info
RATE_LIMIT_MAX=300
ACCESS_STATUS_IP_LIMIT_MAX=3000
